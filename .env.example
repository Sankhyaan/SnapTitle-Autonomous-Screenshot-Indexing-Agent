# ==========================================================
# SnapTitle Environment Configuration Template
# Copy this file to .env and adjust values for your machine:
# cp .env.example .env
# ==========================================================

# Google Gemini API Key (Multimodal Vision titling)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=""
SNAPTITLE_GEMINI_MODEL="gemini-2.5-flash"
SNAPTITLE_AI_PROVIDER="gemini"

# Screenshot Watch Directory
# Leave blank to AUTO-DETECT the operating system's default screenshot folder.
# Or specify a custom folder path:
#   Windows example: SNAPTITLE_SCREENSHOTS_DIR="C:/Users/YourUsername/Pictures/Screenshots"
#   macOS example:   SNAPTITLE_SCREENSHOTS_DIR="/Users/yourusername/Desktop"
#   Linux example:   SNAPTITLE_SCREENSHOTS_DIR="/home/yourusername/Pictures/Screenshots"
SNAPTITLE_SCREENSHOTS_DIR=""

# Popup HUD Notifications
SNAPTITLE_SHOW_POPUP=true
SNAPTITLE_POPUP_DURATION=5

# Database Path
SNAPTITLE_DATABASE_PATH="data/snaptitle.db"

# Local AI Models (Ollama - used if ai_provider is "ollama" or as offline fallback)
SNAPTITLE_LLM_MODEL="llama3.2:3b"
SNAPTITLE_VLM_MODEL="moondream:latest"
SNAPTITLE_OLLAMA_HOST="http://127.0.0.1:11434"

# Custom Tesseract Binary Path (leave blank to auto-detect)
SNAPTITLE_TESSERACT_CMD=""
